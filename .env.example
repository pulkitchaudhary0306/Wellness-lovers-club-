# =============================================================================
# Wellness Lovers Club — Environment Variables Template (.env.example)
#
# Copy this file to .env.local for local development.
# Add NEXT_PUBLIC_* and RAZORPAY_KEY_SECRET as Vercel Environment Variables.
#
# SECURITY RULES:
#   1. Never commit .env.local or any file containing real credentials to Git.
#   2. Never prefix secret keys (Razorpay secret, JWT, Brevo) with NEXT_PUBLIC_.
#   3. JWT_AUTH_SECRET_KEY and WLC_BREVO_API_KEY belong ONLY in wp-config.php
#      on the WordPress server — they must never appear in this file.
# =============================================================================

# ── WordPress Backend REST API URL (no trailing slash) ────────────────────────
NEXT_PUBLIC_WORDPRESS_URL=https://cms.wellnessloversclub.com

# ── Canonical Public Site URL (SEO / Sitemap / OG Tags / Canonical) ──────────
NEXT_PUBLIC_SITE_URL=https://wellnessloversclub.com

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Public Key ID — safe for the browser, used to open Razorpay Checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_KEY_ID

# Secret Key — SERVER-SIDE ONLY. Never use NEXT_PUBLIC_ prefix for this.
# Used exclusively by: /api/payment/create-order and /api/payment/verify-payment
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_SECRET

# =============================================================================
# WordPress Server Constants
# Set ALL of the following in wp-config.php on cms.wellnessloversclub.com
# DO NOT add real values to this file.
# =============================================================================
#
# Generate JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
