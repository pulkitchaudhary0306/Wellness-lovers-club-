# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
scratch/

# ── Security: old credential backups — NEVER commit ──────────────────────────
/wordpress-plugin-restore/
/wordpress-backup/
/wp-backup/
/backup/
/backups/

# WordPress plugin ZIPs (may contain compiled PHP with previously exposed keys)
*.zip
!/deployment_package/

# Deployment packages (excluded from Git; distribute via secure channel only)
/deployment_package/
/production_packages/
